# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=rss
DB_PASSWORD=rss_dev_2026
DB_NAME=robot_scheduling
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT (EMQX)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_WS_PORT=8083
